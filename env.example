# Токен бота от BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# URL для подключения к базе данных Neon
# Формат: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ID админов (разделяются запятыми без пробелов)
# Например: 123456789,987654321,111111111
ADMIN_IDS=YOUR_TELEGRAM_ID

# URL для webhook (Render автоматически заполнит это)
WEBHOOK_URL=https://your-app.onrender.com

# Порт для запуска (обычно 8000)
PORT=8000
